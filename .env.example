# Public site name (optional; defaults to Envowl)
NEXT_PUBLIC_PLATFORM_NAME=Envowl

# Beehiiv — Create Subscription API (https://developers.beehiiv.com)
# Publication: https://goenvowl.beehiiv.com — copy the prefixed Publication ID from
# Beehiiv → Settings → API (e.g. pub_xxxxxxxx).
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Resend — transactional email (e.g. free starter pack from /api/email-capture)
RESEND_API_KEY=

# Stripe — Checkout (server uses secret + price IDs; publishable key for future client-side Stripe.js)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_CLAUDE_LIFE=
STRIPE_PRICE_CLAUDE_BUSINESS=
STRIPE_WEBHOOK_SECRET=

# Optional: canonical app URL for Stripe redirect URLs (defaults to request host in dev, SITE_URL in prod fallback)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: waitlist signups (/api/waitlist, /api/email-capture) and purchase records
# (Stripe webhook, /api/recover-access). Required for the forms and shop to work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
